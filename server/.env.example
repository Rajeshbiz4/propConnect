PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/property_broker_portal
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# Optional: set this in production when API is behind a proxy/domain.
# API_PUBLIC_URL=https://api.example.com
UPLOAD_DIR=uploads

# Property photo upload + automatic optimization
MAX_UPLOAD_MB=20
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1200
IMAGE_WEBP_QUALITY=82
THUMB_WIDTH=500
THUMB_HEIGHT=375
THUMB_WEBP_QUALITY=75

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
DEV_RETURN_RESET_TOKEN=true
